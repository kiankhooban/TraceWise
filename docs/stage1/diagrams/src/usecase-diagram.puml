@startuml usecase-diagram
!include style.iuml
left to right direction
title TraceWise: Use-Case Diagram

actor "AML Analyst" as Analyst
actor "Compliance\nSupervisor" as Supervisor
actor "Automation\nClient" as Auto
actor "LLM Service\n(Anthropic Claude API)" as LLM

Supervisor -|> Analyst

rectangle "TraceWise" {
  usecase "UC03 Configure\nMonitoring Rules" as UC03
  usecase "UC17 View Agent\nPerformance" as UC17
  usecase "UC11 Review Audit Trail" as UC11
  usecase "UC12 Explore\nMoney-Flow Network" as UC12
  usecase "UC01 Import Transactions" as UC01
  usecase "UC02 Run Monitoring\nand Review Alerts" as UC02
  usecase "UC08 Review Agent Proposals" as UC08
  usecase "UC09 Manage Case\n--\nextension points:\ncase closed" as UC09
  usecase "UC10 Reopen Case" as UC10
  usecase "UC16 Search\nKnowledge Base" as UC16
  usecase "UC05 Retrieve Indicators\nand Similar Cases" as UC05
  usecase "UC07 Triage Alert Queue" as UC07
  usecase "UC04 Investigate Alert" as UC04
  usecase "UC06 Verify Agent Claims" as UC06
  usecase "UC13 Ask the Assistant" as UC13
  usecase "UC14 Draft and Finalise\nSuspicious Transaction Report\n--\nextension points:\nreport finalised" as UC14
  usecase "UC15 Export Report" as UC15
}

' Associations, declared in the vertical order wanted.
Analyst -- UC01
Analyst -- UC02
Analyst -- UC08
Analyst -- UC09
Analyst -[hidden]- UC10
Analyst -- UC11
Analyst -- UC12
Analyst -- UC16
Analyst -[hidden]- UC05
Analyst -- UC07
Analyst -- UC04
Analyst -[hidden]- UC06
Analyst -- UC13
Analyst -- UC14
Analyst -[hidden]- UC15

Supervisor -- UC03
Supervisor -- UC17

UC07 -- Auto
UC04 -- Auto
UC13 -- Auto

UC04 -- LLM
UC13 -- LLM
UC14 -- LLM

UC04 .[norank].> UC05 : <<include>>
UC04 .[norank].> UC06 : <<include>>
UC07 .[norank].> UC04 : <<include>>
UC13 .[norank].> UC06 : <<include>>
UC16 .[norank].> UC05 : <<include>>

UC10 .[norank].> UC09 : <<extend>>
UC15 .[norank].> UC14 : <<extend>>
@enduml
