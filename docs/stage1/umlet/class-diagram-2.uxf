<element><id>UMLClass</id><coordinates><x>1622</x><y>171</y><w>360</w><h>160</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;Strategy&gt;&gt;
/DetectionRule/
--

--
/+id(): String/
/+kind(): RuleKind/
/+evaluate(ledger: Ledger): List&lt;RuleMatch&gt;/
/+configure(config: RuleConfig)/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1688</x><y>403</y><w>530</w><h>140</h></coordinates><panel_attributes>&lt;&lt;Template Method&gt;&gt;
/WindowedRule/
--

--
+evaluate(ledger: Ledger): List&lt;RuleMatch&gt;
/#candidates(ledger: Ledger, account: Account): List&lt;Transaction&gt;/
/#isMatch(window: List&lt;Transaction&gt;): boolean/
/#window(): Duration/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1688</x><y>625</y><w>530</w><h>110</h></coordinates><panel_attributes>StructuringRule
--

--
#candidates(ledger: Ledger, account: Account): List&lt;Transaction&gt;
#isMatch(window: List&lt;Transaction&gt;): boolean
#window(): Duration</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>2360</x><y>186</y><w>180</w><h>130</h></coordinates><panel_attributes>Alert
--
-id: String
-ruleId: String
-riskScore: int
-status: AlertStatus
--
</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>2345</x><y>408</y><w>240</w><h>130</h></coordinates><panel_attributes>Transaction
--
-id: String
-timestamp: Instant
-amountCad: BigDecimal
-launderingLabel: Boolean
--
+isInternational(): boolean</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>972</x><y>408</y><w>590</w><h>130</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/Ledger/
--

--
/+accounts(): List&lt;Account&gt;/
/+transactionsFor(accountId: String, range: DateRange): List&lt;Transaction&gt;/
/+findTransaction(id: String): Optional&lt;Transaction&gt;/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>647</x><y>615</y><w>350</w><h>130</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/TransactionRepository/
--

--
/+saveAll(transactions: List&lt;Transaction&gt;)/
/+exists(id: String): boolean/
/+saveAccount(account: Account)/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>202</x><y>403</y><w>380</w><h>140</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/CaseRepository/
--

--
/+save(c: Case)/
/+findById(id: String): Optional&lt;Case&gt;/
/+findByAlert(alertId: String): Optional&lt;Case&gt;/
/+findAll(): List&lt;Case&gt;/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>607</x><y>403</y><w>340</w><h>140</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/AlertRepository/
--

--
/+save(alert: Alert)/
/+find(filter: AlertFilter): List&lt;Alert&gt;/
/+hasOpenAlert(match: RuleMatch): boolean/
/+findById(id: String): Optional&lt;Alert&gt;/</panel_attributes><additional_attributes/></element>
