--
/+save(pending: PendingAction)/
/+findById(id: String): Optional&lt;PendingAction&gt;/
/+findPending(): List&lt;PendingAction&gt;/
/+findAll(): List&lt;PendingAction&gt;/
/+nextId(): String/</panel_attributes><additional_attributes/></element>
