<element><id>UMLClass</id><coordinates><x>357</x><y>227</y><w>360</w><h>170</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;Strategy&gt;&gt;
/DetectionRule/
--

--
/+id(): String/
/+kind(): RuleKind/
/+evaluate(ledger: Ledger): List&lt;RuleMatch&gt;/
/+configure(config: RuleConfig)/
/+config(): RuleConfig/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>120</x><y>499</y><w>530</w><h>140</h></coordinates><panel_attributes>&lt;&lt;Template Method&gt;&gt;
/WindowedRule/
--

--
+evaluate(ledger: Ledger): List&lt;RuleMatch&gt;
/#candidates(ledger: Ledger, account: Account): List&lt;Transaction&gt;/
/#isMatch(account: Account, window: List&lt;Transaction&gt;): boolean/
/#window(): Duration/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>120</x><y>758</y><w>530</w><h>140</h></coordinates><panel_attributes>StructuringRule
--

--
+id(): String
+kind(): RuleKind
#candidates(ledger: Ledger, account: Account): List&lt;Transaction&gt;
#isMatch(account: Account, window: List&lt;Transaction&gt;): boolean
#window(): Duration</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>3540</x><y>232</y><w>180</w><h>160</h></coordinates><panel_attributes>Alert
--
-id: String
-ruleId: String
-accountId: String
-riskScore: int
-priority: int
-status: AlertStatus
--
</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>3495</x><y>474</y><w>360</w><h>190</h></coordinates><panel_attributes>Transaction
--
-id: String
-timestamp: Instant
-senderAccountId: String
-receiverAccountId: String
-amountCad: BigDecimal
-launderingLabel: Boolean
--
+isInternational(): boolean
+isCashDeposit(): boolean
_+isOutsideBank(accountId: String): boolean_</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1427</x><y>489</y><w>590</w><h>160</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/Ledger/
--

--
/+accounts(): List&lt;Account&gt;/
/+transactionsFor(accountId: String, range: DateRange): List&lt;Transaction&gt;/
/+findTransaction(id: String): Optional&lt;Transaction&gt;/
/+findAccount(id: String): Optional&lt;Account&gt;/
/+coverage(): Optional&lt;DateRange&gt;/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>2922</x><y>758</y><w>470</w><h>140</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/TransactionRepository/
--

--
/+saveAll(transactions: List&lt;Transaction&gt;)/
/+exists(id: String): boolean/
/+saveAccount(account: Account)/
/+setWatchlisted(accountId: String, watchlisted: boolean)/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>3012</x><y>499</y><w>380</w><h>140</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/CaseRepository/
--

--
/+save(c: Case)/
/+findById(id: String): Optional&lt;Case&gt;/
/+findByAlert(alertId: String): Optional&lt;Case&gt;/
/+findAll(): List&lt;Case&gt;/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>2457</x><y>469</y><w>530</w><h>200</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/AlertRepository/
--

--
/+save(alert: Alert)/
/+find(filter: AlertFilter): List&lt;Alert&gt;/
/+hasOpenAlert(match: RuleMatch): boolean/
/+findById(id: String): Optional&lt;Alert&gt;/
/+updateStatus(id: String, status: AlertStatus)/
/+updatePriority(id: String, priority: int)/
/+accountsWithAlerts(accountIds: Collection&lt;String&gt;): Set&lt;String&gt;/
/+launderingLabels(): List&lt;AlertLabel&gt;/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>4150</x><y>232</y><w>450</w><h>160</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;Strategy&gt;&gt;
/TransactionFormat/
--

--
/+name(): String/
/+matches(header: List&lt;String&gt;): boolean/
/+header(): List&lt;String&gt;/
/+parse(row: List&lt;String&gt;, rowNumber: int): Transaction/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>4150</x><y>504</y><w>450</w><h>130</h></coordinates><panel_attributes>SamlDCsvFormat
--
-converter: CurrencyConverter
--
+name(): String
+matches(header: List&lt;String&gt;): boolean
+header(): List&lt;String&gt;
+parse(row: List&lt;String&gt;, rowNumber: int): Transaction</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>777</x><y>748</y><w>590</w><h>160</h></coordinates><panel_attributes>&lt;&lt;Decorator&gt;&gt;
AsOfLedger
--
-cutoff: Supplier&lt;Optional&lt;Instant&gt;&gt;
--
+accounts(): List&lt;Account&gt;
+transactionsFor(accountId: String, range: DateRange): List&lt;Transaction&gt;
+findTransaction(id: String): Optional&lt;Transaction&gt;
+findAccount(id: String): Optional&lt;Account&gt;
+coverage(): Optional&lt;DateRange&gt;</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>2042</x><y>489</y><w>390</w><h>160</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
/ApprovalRepository/
