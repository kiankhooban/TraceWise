<element><id>UMLClass</id><coordinates><x>1251</x><y>788</y><w>290</w><h>170</h></coordinates><panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;Command&gt;&gt;
/ActionCommand/
--

--
/+validate(ctx: CommandContext)/
/+execute(ctx: CommandContext)/
/+describe(): String/
/+targetCaseId(): Optional&lt;String&gt;/
/+target(): String/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1213</x><y>1050</y><w>260</w><h>100</h></coordinates><panel_attributes>CloseCaseCommand
--
-caseId: String
--
+validate(ctx: CommandContext)
+execute(ctx: CommandContext)</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>809</x><y>172</y><w>690</w><h>100</h></coordinates><panel_attributes>&lt;&lt;Command: invoker&gt;&gt;
CommandDispatcher
--

--
+submit(command: ActionCommand, actor: Actor, justification: String): DispatchResult</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1538</x><y>389</y><w>520</w><h>80</h></coordinates><panel_attributes>PermissionPolicy
--

--
+tierFor(command: ActionCommand, actor: Actor): PermissionTier</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>823</x><y>344</y><w>690</w><h>170</h></coordinates><panel_attributes>ApprovalQueue
--

--
+enqueue(command: ActionCommand, actor: Actor, justification: String): PendingAction
+approve(pendingId: String, reviewer: Actor)
+reject(pendingId: String, reviewer: Actor, reason: String)
+pending(): List&lt;PendingAction&gt;
+find(pendingId: String): PendingAction
+forCase(caseId: String): List&lt;PendingAction&gt;
+expireWaiting(caseId: String, which: Predicate&lt;ActionCommand&gt;, reason: String)</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1201</x><y>586</y><w>390</w><h>130</h></coordinates><panel_attributes>PendingAction
--
-id: String
-status: ProposalStatus
--
+markApproved(reviewer: Actor)
+markRejected(reviewer: Actor, reason: String)
+markExpired(reason: String)</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>796</x><y>601</y><w>380</w><h>100</h></coordinates><panel_attributes>AuditLog
--

--
+append(entry: AuditEntry)
+query(filter: AuditFilter): List&lt;AuditEntry&gt;</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1758</x><y>1254</y><w>290</w><h>200</h></coordinates><panel_attributes>&lt;&lt;State: context&gt;&gt;
Case
--
-id: String
--
+startInvestigation()
+submitForApproval()
+returnToInvestigation()
+escalate()
+close()
+reopen(reason: String)
+addFinding(finding: AgentFinding)
+changeState(next: CaseState)</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>2103</x><y>1526</y><w>280</w><h>140</h></coordinates><panel_attributes>&lt;&lt;State&gt;&gt;
/CaseState/
--

--
+startInvestigation(c: Case)
+close(c: Case)
+reopen(c: Case, reason: String)
/+status(): CaseStatus/</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>2103</x><y>1738</y><w>280</w><h>100</h></coordinates><panel_attributes>ClosedState
--

--
+reopen(c: Case, reason: String)
+status(): CaseStatus</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1678</x><y>1531</y><w>400</w><h>130</h></coordinates><panel_attributes>AgentFinding
--
-verdict: Verdict
-confidence: double
-narrative: String
--
+claims(): List&lt;Claim&gt;
+attachVerification(report: VerificationReport)</panel_attributes><additional_attributes/></element>
<element><id>UMLClass</id><coordinates><x>1498</x><y>1030</y><w>370</w><h>140</h></coordinates><panel_attributes>FinaliseReportCommand
