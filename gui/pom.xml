<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.kiankhooban</groupId>
    <artifactId>tracewise-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tracewise-gui</artifactId>
  <name>TraceWise GUI</name>
  <description>JavaFX views over TraceWiseFacade</description>

  <properties>
    <tracewise.main>tracewise.ui.gui.GuiMain</tracewise.main>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.kiankhooban</groupId>
      <artifactId>tracewise-core</artifactId>
    </dependency>
    <dependency>
      <!-- GUI (JavaFX 21); the platform's native libraries are picked by the openjfx parent pom -->
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>21.0.12</version>
    </dependency>
    <dependency>
      <!-- F09 money-flow graph (named in the Stage 1 design); 2.3.0, June 2025. Its own JavaFX 21.0.1 is
           excluded so the application's JavaFX version is the only one on the class path -->
      <groupId>com.brunomnsilva</groupId>
      <artifactId>smartgraph</artifactId>
      <version>2.3.0</version>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.github.kiankhooban</groupId>
      <artifactId>tracewise-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>runnable-jar</id>
            <configuration>
              <finalName>tracewise-gui</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
